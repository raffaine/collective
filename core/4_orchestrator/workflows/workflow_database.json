          "id": "UserTask_L1b_SpatialActuation",
          "bpmn_type": "UserTask",
          "layer": "L2/L1b",
          "name": "UserTask (L2/L1b Actuation)",
          "expression": "actuate_voxel_task(taskId=1, target='(9,2,7)', delta='+4.5 kWh/d')"
        },
