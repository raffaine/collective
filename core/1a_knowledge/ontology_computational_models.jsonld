{
  "@context": {
    "mesh": "https://collective.network/ontology/v1/computational_models/",
    "schema": "https://schema.org/",
    "qudt": "http://qudt.org/schema/qudt/",
    "unit": "http://qudt.org/vocab/unit/"
  },
  "@graph": [
    {
      "@id": "mesh:ComputationalModel",
      "@type": "schema:Class",
      "schema:name": "Computational Model",
      "schema:description": "A formalized equation or algorithm used to calculate thermodynamic exchanges and state transitions within the Node."
    },
    {
      "@id": "mesh:MacroComputeEfficiency",
      "@type": "schema:Class",
      "schema:subClassOf": "mesh:ComputationalModel",
      "schema:name": "Macro Compute Efficiency (Hardware TDP)",
      "schema:description": "The macro-level model linking CPU/GPU operations to Joules of heat dissipated. Prevents the simulation from treating compute as free."
    },
    {
      "@id": "mesh:LLMTokenEnergyCost",
      "@type": "schema:Class",
      "schema:subClassOf": "mesh:ComputationalModel",
      "schema:name": "LLM Token Energy Cost",
      "schema:description": "The specific thermodynamic coefficient for AI-Human Studio development. Maps 1 Inference Token generated by the Architect/Scribe agents to an estimated micro-Joule cost at the data center."
    },
    {
      "@id": "mesh:CyclomaticEntropyEquation",
      "@type": "schema:Class",
      "schema:subClassOf": "mesh:ComputationalModel",
      "schema:name": "Cyclomatic Entropy Equation",
      "schema:description": "Models the accumulation of technical debt. As Digital Mass (Bytes) increases without RefactorIntents, the Exergy cost of future Git Commits (Entropy Deltas) increases exponentially."
    },
    {
      "@id": "mesh:joulesPerToken",
      "@type": "schema:Property",
      "schema:domainIncludes": "mesh:LLMTokenEnergyCost",
      "schema:rangeIncludes": "schema:Number",
      "qudt:hasUnit": "unit:J",
      "schema:description": "The localized or global average of energy consumed to generate one token of AI inference."
    },
    {
      "@id": "mesh:negentropyCoefficient",
      "@type": "schema:Property",
      "schema:domainIncludes": "mesh:CyclomaticEntropyEquation",
      "schema:rangeIncludes": "schema:Number",
      "schema:description": "The multiplier by which a deliberate refactor reduces the complexity friction of the codebase."
    }
  ]
}
